  "implementation_contract": {
    "minimum_calendar_dto_fields": [
      "event_key_for_dedupe",
      "start_at",
      "end_at",
      "timezone",
      "is_all_day",
      "recurrence_or_series_key",
      "calendar_kind",
      "title_or_bounded_description",
      "owner_role",
      "owner_response",
      "has_minutes_or_explicit_message_reference"
    ],
    "normalized_output_fields": [
      "route",
      "source_retained",
      "candidate_created",
      "requires_owner_confirmation",
      "explanation_code",
      "evidence_fields",
      "correction_scope"
    ],
    "must_not_request_or_expose": [
      "full_attendee_directory",
      "raw_user_ids",
      "full_meeting_transcript",
      "raw_calendar_payload",
      "provider_or_model_prompt",
      "source_deletion_as_filtering"
    ],
    "production_behavior_status": "not_changed_by_issue_85"
  }
