      "signals": [],
      "expected_route": "calendar_fact",
      "candidate_created": false,
      "source_retained": true,
      "explanation_code": "calendar_attendance_only",
      "explanation": "仅出席，不推断任务。"
    },
    {
      "id": "negative-all-day-01",
      "kind": "negative",
