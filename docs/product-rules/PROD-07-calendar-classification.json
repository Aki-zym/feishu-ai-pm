{
  "schema_version": 1,
  "id": "PROD-07",
  "title": "日历事实与任务候选分类规则",
  "status": "contract_only",
  "owner": "product_owner",
  "last_reviewed": "2026-08-16",
  "target": "M1 / 首个受控单用户试点 / calendar source classification",
  "scope": "本文件只定义产品规则、合成验收夹具和后续实现输入输出；本 Issue 不修改生产分类行为。",
  "evidence_ceiling": ["L0"],
  "source_policy": {
    "calendar_fact_is_authoritative": true,
    "filtered_event_is_retained": true,
    "raw_content_not_uploaded": true,
    "meeting_placeholder_is_not_action": true,
    "minutes_or_explicit_message_preferred_for_action_item": true
  },
  "routes": {
    "calendar_fact": {
      "meaning": "时间事实或提醒，保留在 Calendar 来源和日历展示中",
      "candidate_created": false,
      "owner_confirmation_required": false,
      "source_retained": true,
      "explanation_required": false
    },
    "candidate_review": {
      "meaning": "明确责任、动作和交付物/截止点，生成一个待主人确认的候选",
      "candidate_created": true,
      "owner_confirmation_required": true,
      "source_retained": true,
      "explanation_required": true
    },
    "owner_confirmation": {
      "meaning": "有行动迹象但责任或交付边界不完整，只提示主人确认，不批量制造候选",
      "candidate_created": false,
      "owner_confirmation_required": true,
      "source_retained": true,
      "explanation_required": true
    }
  },
  "role_matrix": [
    {
      "role": "organizer",
      "default_route": "calendar_fact",
      "candidate_condition": "仅当正文明确主人负责动作且同时有交付物或截止点",
      "does_not_imply_task": true
    },
    {
      "role": "required_attendee",
      "default_route": "calendar_fact",
      "candidate_condition": "仅出席不构成候选；需要主人责任、动作和交付信号",
      "does_not_imply_task": true
    },
    {
      "role": "optional_attendee",
      "default_route": "calendar_fact",
      "candidate_condition": "仅在正文明确主人交付责任时进入后续规则",
      "does_not_imply_task": true
    },
    {
      "role": "no_response",
      "default_route": "calendar_fact",
      "candidate_condition": "不得因未响应推断主人需要执行；责任不明时只走确认提示",
      "does_not_imply_task": true
    }
  ],
  "event_matrix": [
    { "event_type": "ordinary_reminder", "default_route": "calendar_fact", "reason": "普通提醒只是时间事实" },
    { "event_type": "attendance_only", "default_route": "calendar_fact", "reason": "仅出席不等于主人有交付责任" },
    { "event_type": "meeting_placeholder", "default_route": "calendar_fact", "reason": "会议占位不能单独推断 action item" },
    { "event_type": "all_day", "default_route": "calendar_fact", "reason": "全天属性不增加任务责任" },
    { "event_type": "recurring", "default_route": "calendar_fact", "reason": "重复属性不增加任务责任，后续实现需按系列去重" },
    { "event_type": "holiday", "default_route": "calendar_fact", "reason": "节假日是订阅或时间事实" },
    { "event_type": "birthday", "default_route": "calendar_fact", "reason": "生日提醒默认不是交付任务" },
    { "event_type": "subscribed_calendar", "default_route": "calendar_fact", "reason": "订阅日历默认只提供事实" },
    { "event_type": "explicit_owner_delivery", "default_route": "candidate_review", "reason": "明确主人责任、动作和交付物或截止点" },
    { "event_type": "minutes_action_item", "default_route": "candidate_review", "reason": "纪要或明确消息提供了可追溯 action item" },
    { "event_type": "ambiguous_action", "default_route": "owner_confirmation", "reason": "有行动词但责任或交付边界不完整" }
  ],
  "decision_rules": {
    "candidate_requires_all": ["explicit_owner_responsibility", "action", "deliverable_or_deadline"],
    "explicit_action_verbs": ["准备", "提交", "评审", "确认", "交付", "整理", "回复", "更新", "跟进"],
    "owner_responsibility_signals": ["我负责", "由我", "请我", "主人需要", "我来提交", "我来确认"],
    "deliverable_or_deadline_signals": ["报告", "名单", "文档", "结果", "方案", "截止", "到期", "之前完成", "周一前", "明天前"],
    "non_signals": ["仅供参考", "提醒一下", "欢迎参加", "可选参加", "生日快乐", "节假日", "订阅日历", "例会"],
    "uncertain_rule": {
      "route": "owner_confirmation",
      "candidate_created": false,
      "source_retained": true,
      "bulk_candidate_creation": false,
      "missing_signal_policy": "owner_confirmation",
      "scope": "single_event",
      "required_fields": ["missing_signal_code", "source_reference"],
      "forbidden_fields": ["raw_source_content", "global_calendar_filter", "source_deletion"]
    },
    "meeting_rule": {
      "placeholder_route": "calendar_fact",
      "placeholder_is_action": false,
      "action_item_sources": ["minutes", "explicit_message"],
      "requires_all_candidate_signals": true,
      "source_retained": true,
      "scope": "event_then_explicit_related_source"
    },
    "explanation_rule": {
      "calendar_fact": {
        "route": "calendar_fact",
        "required_fields": [],
        "forbidden_fields": ["raw_source_content", "provider_payload", "attendee_directory"],
        "source_reference_required": false,
        "raw_content_allowed": false,
        "free_text_allowed": false,
        "scope": "none"
      },
      "candidate_review": {
        "route": "candidate_review",
        "required_fields": ["owner_responsibility", "action", "deliverable_or_deadline", "source_reference"],
        "forbidden_fields": ["raw_source_content", "provider_payload", "attendee_directory"],
        "source_reference_required": true,
        "raw_content_allowed": false,
        "free_text_allowed": false,
        "scope": "redacted_explanation"
      },
      "owner_confirmation": {
        "route": "owner_confirmation",
        "required_fields": ["missing_signal_code", "source_reference"],
        "forbidden_fields": ["raw_source_content", "provider_payload", "attendee_directory"],
        "source_reference_required": true,
        "raw_content_allowed": false,
        "free_text_allowed": false,
        "scope": "redacted_explanation"
      }
    }
  },
  "correction_rule": {
    "entry_label": "这只是提醒",
    "current_event_scope": "current_event_only",
    "series_scope": "explicit_owner_selection_only",
    "learning_boundary": "same_event_family_only",
    "reclassification_boundary": "derived_state_only",
    "source_mutation": "forbidden",
    "audit_event": "private_correction_event_required",
    "global_filter": false,
    "global_source_deletion": false,
    "requires_new_revision": true,
    "idempotency": "operation_id_required"
  },
  "examples": [
    {
      "id": "negative-reminder-01",
      "kind": "negative",
      "role": "organizer",
      "event_type": "ordinary_reminder",
      "title": "周例会提醒",
      "description": "提醒主人周三 10:00 参加例会。",
      "signals": [],
      "expected_route": "calendar_fact",
      "candidate_created": false,
      "source_retained": true,
      "explanation_code": "calendar_reminder",
