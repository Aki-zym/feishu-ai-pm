{
  "schemaVersion": 2,
  "id": "ai-pm-intake",
  "name": "TooManyTasks",
  "description": "把已授权飞书消息整理为 TooManyTasks 入库候选，并维护当前会话的任务进度。本机后台运行时菜单栏会显示 TooManyTasks，点击打开任务台。",
  "whenToUse": "需要扫描已授权飞书消息或把当前会话的实际进展写回任务台时使用；本机后台运行时菜单栏会显示 TooManyTasks，点击打开任务台。",
  "version": "0.6.0",
  "entry": "main.js",
  "launch": "resident",
  "slots": ["tool", "agent", "node", "cindy", "session-context", "skill", "subscribe"],
  "agent": { "errand": true, "schedule": true },
  "command": "扫近10分钟",
  "tools": [
    {
      "name": "get_pm_tasks",
      "description": "读取当前任务快照，供入库扫描判断已有任务归属和版本。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "save_pm_sources",
      "description": "读取到飞书消息后立即保存最小来源事实，取得产品签发的 opaque source_receipt；必须在任务语义判断前调用。",
      "parameters": {
        "type": "object",
        "properties": {
          "save_request_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "properties": {
                "client_ref": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "provider": { "type": "string", "enum": ["feishu", "synthetic"] },
                "source_kind": { "type": "string", "enum": ["im_message", "im_thread_message", "im_reaction_context", "synthetic_message"] },
                "stable_message_id": { "type": "string", "minLength": 1, "maxLength": 500 },
                "occurred_at": { "type": "string", "minLength": 1, "maxLength": 80 },
                "sender_id": { "type": "string", "minLength": 1, "maxLength": 500 },
                "display_name": {},
                "chat_id": { "type": "string", "minLength": 1, "maxLength": 500 },
                "thread_id": { "type": "string", "minLength": 1, "maxLength": 500 },
                "mentioned_owner": { "type": "boolean" },
                "sender_is_owner": { "type": "boolean" },
                "message_type": { "type": "string", "enum": ["text", "post", "image", "file", "audio", "video", "sticker", "interactive", "system", "unknown"] },
                "reactions": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string", "minLength": 1, "maxLength": 80 },
                      "actor_is_owner": { "type": "boolean" }
                    },
                    "required": ["type", "actor_is_owner"],
                    "additionalProperties": false
                  }
                },
                "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
                "revision": {
                  "type": "object",
                  "properties": {
                    "modified_at": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "sequence": { "type": "integer", "minimum": 0 }
                  },
                  "additionalProperties": false
                },
                "relations": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": { "type": "string", "enum": ["reply_to", "thread_parent"] },
                      "client_ref": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                      "source_receipt": { "type": "string", "minLength": 32, "maxLength": 200 }
                    },
                    "required": ["kind"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["client_ref", "provider", "source_kind", "stable_message_id", "occurred_at", "sender_id", "chat_id", "mentioned_owner", "sender_is_owner", "message_type", "text"],
              "additionalProperties": false
            }
          }
        },
        "required": ["save_request_id", "sources"],
        "additionalProperties": false
      }
    },
    {
      "name": "submit_pm_decisions",
      "description": "只用已保存来源的 source_receipt 提交完整 snapshot 的 batch/group/primary/shared_context 判断；不得重传 raw sources。",
      "parameters": {
        "type": "object",
        "properties": {
          "decision_request_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "batch_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "window_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "window_start": { "type": "string", "minLength": 1, "maxLength": 80 },
          "window_end": { "type": "string", "minLength": 1, "maxLength": 80 },
          "snapshot_receipts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 32, "maxLength": 200 }
          },
          "groups": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "group_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "action": { "type": "string", "enum": ["create_candidate", "update_task"] },
                "anchor_receipt": { "type": "string", "minLength": 32, "maxLength": 200 },
                "field_evidence_receipts": {
                  "type": "array",
                  "maxItems": 99,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 32, "maxLength": 200 }
                },
                "task_key": { "type": "string", "maxLength": 200 },
                "expected_version": { "type": "integer", "minimum": 1 },
                "title": { "type": "string", "maxLength": 160 },
                "describe": { "type": "string", "maxLength": 2000 },
                "next_step": { "type": "string", "maxLength": 1000 },
                "reason": { "type": "string", "maxLength": 500 }
              },
              "required": ["group_key", "action", "anchor_receipt", "field_evidence_receipts"],
              "additionalProperties": false
            }
          },
          "primary_dispositions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "disposition_ref": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "source_receipt": { "type": "string", "minLength": 32, "maxLength": 200 },
                "disposition": { "type": "string", "enum": ["group", "skip", "needs_owner"] },
                "primary_group_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "owner_decision_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "reason": { "type": "string", "maxLength": 500 }
              },
              "required": ["disposition_ref", "source_receipt", "disposition"],
              "additionalProperties": false
            }
          },
          "shared_context": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "properties": {
                "source_receipt": { "type": "string", "minLength": 32, "maxLength": 200 },
                "shared_group_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
              },
              "required": ["source_receipt", "shared_group_key"],
              "additionalProperties": false
            }
          },
          "owner_decisions": {
            "type": "array",
            "maxItems": 100,
            "description": "每个 decision 的 canonical stored options JSON 最多 10000 个 SQLite 文本字符；插件提交前会校验聚合容量。",
            "items": {
              "type": "object",
              "properties": {
                "decision_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10,
                  "items": {
                    "type": "object",
                    "properties": {
                      "option_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                      "action": { "type": "string", "enum": ["skip", "create_candidate", "append_candidate"] },
                      "title": { "type": "string", "maxLength": 160 },
                      "describe": { "type": "string", "maxLength": 2000 },
                      "next_step": { "type": "string", "maxLength": 1000 },
                      "candidate_key": { "type": "string", "maxLength": 200 }
                    },
                    "required": ["option_key", "action"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["decision_key", "reason", "options"],
              "additionalProperties": false
            }
          }
        },
        "required": ["decision_request_id", "batch_id", "window_id", "window_start", "window_end", "snapshot_receipts", "groups", "primary_dispositions"],
        "additionalProperties": false
      }
    },
    {
      "name": "scan_intake_window",
      "description": "扫描已授权飞书消息：读取后先用 save_pm_sources 可靠保存并取得 receipt，再获取任务快照并用 submit_pm_decisions 提交判断。入库 errand 会话内禁止调用本工具。",
      "parameters": {
        "type": "object",
        "properties": {
          "trigger": {
            "type": "string",
            "enum": ["manual", "schedule"],
            "default": "manual"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "update_pm_progress",
      "description": "在设置为主动模式时，用独立轻量模型判断当前会话所属任务及是否需要更新进度。自动模式会在轮次结束后后台评估。",
      "parameters": {
        "type": "object",
        "properties": {
          "goal": { "type": "string", "maxLength": 1600 },
          "completed": { "type": "string", "maxLength": 2600 },
          "verification": { "type": "string", "maxLength": 1800 },
          "blockers": { "type": "string", "maxLength": 1000 },
          "next_step": { "type": "string", "maxLength": 1200 },
          "status_hint": { "type": "string", "enum": ["unknown", "in_progress", "waiting", "review", "completed"] }
        },
        "required": ["goal", "completed", "verification", "blockers", "next_step", "status_hint"],
        "additionalProperties": false
      }
    }
  ],
  "cindy": {
    "text": ["oneshot"],
    "oneshotModel": "codex/gpt-5.6-luna"
  },
  "subscribe": {
    "topics": ["turn"],
    "hooks": ["will-user-message"]
  },
  "node": {
    "entry": "node/worker.cjs",
    "protocol": "json-rpc-stdio",
    "lifecycle": "resident",
    "secretBindings": [{
      "key": "pm_token",
      "label": "本机服务令牌",
      "hint": "只用于本机 HTTP Bearer 鉴权；轮换不会改变可信来源身份。",
      "methods": ["pm/request", "pm/ensure", "pm/stop", "pm/restart", "cindy/read-completed-turn"]
    }, {
      "key": "pm_account_anchor",
      "label": "连接账号锚点",
      "hint": "插件首次启动时自动生成并稳定保存，用于绑定可信来源身份。",
      "methods": ["pm/ensure", "pm/restart"]
    }, {
      "key": "pm_receipt_secret",
      "label": "来源凭证密钥",
      "hint": "插件首次启动时自动生成并稳定保存，只用于签发和验证来源 receipt。",
      "methods": ["pm/ensure", "pm/restart"]
    }]
  },
  "skill": {
    "items": [{
      "dir": "skills/pm-progress-update",
      "name": "pm-progress-update",
      "description": "在主动模式下同步当前会话实际进展；自动模式由轮次结束后台评估。"
    }]
  },
  "settingsHtml": "settings.html",
  "settingsHeight": 300
}
