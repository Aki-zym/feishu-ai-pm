{
  "schemaVersion": 2,
  "id": "ai-pm-intake",
  "name": "TooManyTasks",
  "description": "调用独立运行的 TooManyTasks 后台 Aily 扫描；插件每 5 分钟领取一条已生成摘要，由 Cindy 结合本地任务快照判断入库，并维护当前会话的任务进度。",
  "whenToUse": "需要立即请求独立 TooManyTasks 开始后台 Aily 扫描，或把当前 Cindy 会话的实际进展写回本机任务台时使用。",
  "version": "0.7.0",
  "entry": "main.js",
  "launch": "resident",
  "slots": ["tool", "agent", "node", "cindy", "session-context", "skill", "subscribe"],
  "agent": { "errand": true },
  "command": "扫近10分钟",
  "tools": [
    {
      "name": "get_pm_tasks",
      "description": "读取当前任务快照，供入库扫描判断已有任务归属和版本。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "submit_intake",
      "description": "提交一次任务入库窗口的派生来源和 Cindy 判断提案；服务端按现有任务快照与 CAS 合同登记候选或更新正式任务。",
      "parameters": {
        "type": "object",
        "properties": {
          "window_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "window_start": { "type": "string", "minLength": 1, "maxLength": 80 },
          "window_end": { "type": "string", "minLength": 1, "maxLength": 80 },
          "result_kind": { "type": "string", "enum": ["intake", "empty_window"] },
          "sources": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "properties": {
                "source_key": { "type": "string", "minLength": 1, "maxLength": 120 },
                "occurred_at": { "type": "string", "minLength": 1, "maxLength": 80 },
                "conversation_key": { "type": "string", "maxLength": 240 },
                "sender_role": { "type": "string", "maxLength": 120 },
                "source_kind": { "type": "string", "enum": ["aily_summary"] },
                "agent_id": { "type": "string", "minLength": 1, "maxLength": 160 },
                "generated_at": { "type": "string", "minLength": 1, "maxLength": 80 },
                "text": { "type": "string", "minLength": 1, "maxLength": 20000 }
              },
              "required": ["source_key", "occurred_at", "text"],
              "additionalProperties": false
            }
          },
          "proposals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": { "type": "string", "enum": ["create_candidate", "update_task", "skip", "needs_owner"] },
                "source_keys": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1, "maxLength": 120 }
                },
                "task_key": { "type": "string", "maxLength": 200 },
                "expected_version": { "type": "integer", "minimum": 1 },
                "title": { "type": "string", "maxLength": 160 },
                "describe": { "type": "string", "maxLength": 2000 },
                "next_step": { "type": "string", "maxLength": 1000 },
                "reason": { "type": "string", "maxLength": 2000 }
              },
              "required": ["action", "source_keys"],
              "additionalProperties": false
            }
          }
        },
          "required": ["window_id", "window_start", "window_end", "result_kind", "sources", "proposals"],
        "additionalProperties": false
      }
    },
    {
      "name": "scan_intake_window",
      "description": "立即请求独立 TooManyTasks 启动一轮后台 Aily 扫描并快速返回。摘要完成后，常驻插件会在 5 分钟轮询中领取摘要并派发固定 intake errand；入库 errand 会话内禁止递归调用本工具。",
      "parameters": {
        "type": "object",
        "properties": {
          "trigger": {
            "type": "string",
            "enum": ["manual", "schedule"],
            "default": "manual"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "update_pm_progress",
      "description": "在设置为主动模式时，用独立轻量模型判断当前会话所属任务及是否需要更新进度。自动模式会在轮次结束后后台评估。",
      "parameters": {
        "type": "object",
        "properties": {
          "goal": { "type": "string", "maxLength": 1600 },
          "completed": { "type": "string", "maxLength": 2600 },
          "verification": { "type": "string", "maxLength": 1800 },
          "blockers": { "type": "string", "maxLength": 1000 },
          "next_step": { "type": "string", "maxLength": 1200 },
          "status_hint": { "type": "string", "enum": ["unknown", "in_progress", "waiting", "review", "completed"] }
        },
        "required": ["goal", "completed", "verification", "blockers", "next_step", "status_hint"],
        "additionalProperties": false
      }
    }
  ],
  "cindy": {
    "text": ["oneshot"],
    "oneshotModel": "codex/gpt-5.6-luna"
  },
  "subscribe": {
    "topics": ["turn"],
    "hooks": ["will-user-message"]
  },
  "node": {
    "entry": "node/worker.cjs",
    "protocol": "json-rpc-stdio",
    "lifecycle": "resident"
  },
  "skill": {
    "items": [{
      "dir": "skills/pm-progress-update",
      "name": "pm-progress-update",
      "description": "在主动模式下同步当前会话实际进展；自动模式由轮次结束后台评估。"
    }]
  },
  "settingsHtml": "settings.html",
  "settingsHeight": 330
}
