# 只保留字段名，不要把真实值提交到 GitHub。

# 本地空壳：默认使用 Node 24 内置 SQLite。
DATABASE_URL=file:./var/ai-pm.sqlite
DATABASE_PROVIDER=sqlite
POSTGRES_URL=
PORT=4310
WEB_ORIGIN=http://localhost:5173
LOG_RETENTION_DAYS=30
APP_VERSION=0.2.0
# 可选：构建时注入 commit SHA 或 CI build ID；只允许字母、数字、点、下划线和短横线。
BUILD_IDENTITY=

# 工作区：当前仅保存 reference path，不扫描、不写入、不归档。
WORKSPACE_MODE=reference_only
WORKSPACE_READ_ENABLED=false
WORKSPACE_WRITE_ENABLED=false
# JSON array of directories explicitly chosen by the user; never commit real paths.
WORKSPACE_ALLOWED_PATHS=[]

# Cindy → 本地 PM 入库接口；留空时所有 Cindy 集成请求均返回 401。
CINDY_INTEGRATION_TOKEN=
