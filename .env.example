# 只保留字段名，不要把真实值提交到 GitHub。

# 本地空壳：默认使用 Node 24 内置 SQLite。
DATABASE_URL=file:./var/ai-pm.sqlite
DATABASE_PROVIDER=sqlite
POSTGRES_URL=
PORT=4310
WEB_ORIGIN=http://localhost:5173
LOG_RETENTION_DAYS=30
APP_VERSION=0.2.0
# 可选：构建时注入 commit SHA 或 CI build ID；只允许字母、数字、点、下划线和短横线。
BUILD_IDENTITY=

# TooManyTasks 与 Cindy Worker 共用的私有配置目录；留空时使用当前平台的 ai-pm-intake 应用数据目录。
TOOMANYTASKS_CONFIG_ROOT=
# 旧服务端变量仍兼容；新配置统一使用 TOOMANYTASKS_CONFIG_ROOT。
CONFIG_ROOT=
# 可选：部署环境自管的主密钥；留空时首次启动生成本机 master.key。
TOKEN_ENCRYPTION_KEY=

# 独立 Aily 应用。App ID、App Secret 和 Agent ID 必须由当前安装自行配置；不要提交真实值。
AILY_APP_ID=
AILY_APP_SECRET=
AILY_AGENT_ID=
AILY_DOMAIN=feishu
AILY_OAUTH_REDIRECT_URI=http://127.0.0.1:4310/oauth/aily/callback
AILY_OAUTH_SCOPES=aily:agent_chat:write auth:user.id:read im:chat:read im:message:readonly im:message.group_msg:get_as_user im:message.p2p_msg:get_as_user search:docs:read calendar:calendar.event:read offline_access

# 工作区：当前仅保存 reference path，不扫描、不写入、不归档。
WORKSPACE_MODE=reference_only
WORKSPACE_READ_ENABLED=false
WORKSPACE_WRITE_ENABLED=false
# JSON array of directories explicitly chosen by the user; never commit real paths.
WORKSPACE_ALLOWED_PATHS=[]

# 可选覆盖：默认由 TooManyTasks 首次启动自动生成到私有配置目录。
CINDY_INTEGRATION_TOKEN=
