# 只保留字段名，不要把真实值提交到 GitHub。

# 本地空壳：默认使用 Node 24 内置 SQLite。
DATABASE_URL=file:./var/ai-pm.sqlite
DATABASE_PROVIDER=sqlite
POSTGRES_URL=
PORT=4310
WEB_ORIGIN=http://localhost:5173
LOG_RETENTION_DAYS=30
APP_VERSION=0.2.0
# 可选：构建时注入 commit SHA 或 CI build ID；只允许字母、数字、点、下划线和短横线。
BUILD_IDENTITY=

# 飞书：默认关闭真实连接；只有填写凭证并显式打开后才会请求外部 API。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu
FEISHU_EVENT_MODE=websocket
FEISHU_OAUTH_REDIRECT_URI=
FEISHU_OAUTH_SCOPES=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_EXTERNAL_ENABLED=false
# 仅供机器人补充入口；主人个人信息流的群选择保存在本地数据库，不使用这里。
FEISHU_GROUP_IDS=
FEISHU_SCAN_ENABLED=false
FEISHU_SCAN_INTERVAL_SECONDS=60
FEISHU_SCAN_OVERLAP_SECONDS=300
FEISHU_SCAN_PAGE_SIZE=50
TOKEN_ENCRYPTION_KEY=

# 模型：默认 rule_mock，不调用外部模型。
LLM_PROVIDER=rule_mock
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# 工作区：当前仅保存 reference path，不扫描、不写入、不归档。
WORKSPACE_MODE=reference_only
WORKSPACE_READ_ENABLED=false
WORKSPACE_WRITE_ENABLED=false
# JSON array of directories explicitly chosen by the user; never commit real paths.
WORKSPACE_ALLOWED_PATHS=[]

