{
  "name": "feishu-ai-pm",
  "version": "0.2.0",
  "private": true,
  "description": "TooManyTasks 本机任务库与 Cindy 入库服务",
  "author": "guanchen-dotcom",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "docs:generate": "node scripts/docs-generate.mjs",
    "docs:check": "node scripts/docs-check-run.mjs",
    "docs:test": "node --test scripts/docs-check.test.mjs scripts/domain-contracts-check.test.mjs scripts/governance-check.test.mjs scripts/decision-register-check.test.mjs scripts/prod-07-calendar-contract-check.test.mjs",
    "governance:test": "node --test scripts/governance-check.test.mjs",
    "ci:policy:test": "node --test scripts/ci-selection-policy.test.mjs scripts/ci-log-policy.test.mjs scripts/playwright-evidence-policy.test.mjs scripts/evidence-record-policy.test.mjs scripts/run-vitest-inventory.test.mjs",
    "verify:local": "node scripts/local-verification.mjs local",
    "test:e2e:matcher": "npm exec --workspace @ai-pm/server -- tsx --test ../../tests/unit/expected-event-matcher.test.ts",
    "dev": "concurrently -n server,web -c blue,cyan \"npm run dev -w @ai-pm/server\" \"npm run dev -w @ai-pm/web\"",
    "build": "npm run build -w @ai-pm/web && npm run build -w @ai-pm/server",
    "start": "npm run start -w @ai-pm/server",
    "test:plugin": "node --test plugins/cindy-pm-intake/main.test.mjs plugins/cindy-pm-intake/settings.test.mjs plugins/cindy-pm-intake/node/worker.test.mjs plugins/cindy-pm-intake/node/pm-runtime.test.mjs plugins/cindy-pm-intake/node/pm-runtime.shutdown.test.mjs",
    "test:server:current": "npm test -w @ai-pm/server -- tests/cindy-intake.test.ts tests/runtime-shutdown.test.ts tests/seed-intake-route.test.ts tests/app.test.ts",
    "test:web:current": "npm test -w @ai-pm/web",
    "test:current": "npm run test:plugin && npm run test:server:current && npm run test:web:current",
    "test": "node scripts/run-vitest-inventory.mjs",
    "typecheck": "npm run typecheck -w @ai-pm/server && npm run typecheck -w @ai-pm/web",
    "check:runtime": "npm run test:current",
    "check": "npm run typecheck && npm run test:current",
    "test:e2e:lifecycle": "node scripts/test-e2e-lifecycle.mjs",
    "test:e2e:inventory": "node scripts/playwright-inventory.mjs",
    "test:e2e:verify": "node scripts/playwright-results-verify.mjs",
    "test:e2e": "playwright test",
    "capture:ui": "node scripts/capture-ui.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9"
  },
  "allowScripts": {
    "esbuild@0.25.9": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true
  }
}
